{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3010
    },
    {
      "name": "Next.js Dev Server (Safe - auto port cleanup)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:safe"],
      "port": 3010
    },
    {
      "name": "Next.js Production Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3010
    }
  ]
}
